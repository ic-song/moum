{
  "name": "@moum/grid",
  "version": "0.8.0",
  "type": "module",
  "description": "Dependency-free editable data grid with range selection and transactional clipboard operations.",
  "license": "MIT",
  "main": "dist/moum-grid.cjs",
  "module": "dist/moum-grid.mjs",
  "browser": "dist/moum-grid.js",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./dist/moum-grid.mjs"
      },
      "require": {
        "types": "./dist/moum-grid.d.cts",
        "default": "./dist/moum-grid.cjs"
      }
    },
    "./style.css": "./dist/moum-grid.css",
    "./realgrid-compat": {
      "import": {
        "types": "./realgrid-compat.d.ts",
        "default": "./dist/moum-realgrid.mjs"
      },
      "require": {
        "types": "./dist/moum-realgrid.d.cts",
        "default": "./dist/moum-realgrid.cjs"
      }
    }
  },
  "files": [
    "dist",
    "vendor",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SHA256SUMS.txt",
    "index.d.ts",
    "realgrid-compat.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ic-song/moum.git",
    "directory": "packages/grid"
  },
  "homepage": "https://github.com/ic-song/moum/tree/main/packages/grid",
  "bugs": {
    "url": "https://github.com/ic-song/moum/issues"
  },
  "keywords": [
    "grid",
    "datagrid",
    "javascript",
    "offline",
    "spreadsheet",
    "clipboard"
  ],
  "types": "index.d.ts"
}
